# =============================================================================
# SecretPixel Root Environment Configuration Example
# =============================================================================

# --- Backend Configuration (Render Environment Variables) ---
PORT=8000
HOST=0.0.0.0
# Set ALLOWED_ORIGINS to your Vercel deployment domain to restrict CORS in production
# Example: ALLOWED_ORIGINS=https://secretpixel.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=*

# Optional: Custom path to compiled C binary (defaults to auto-detected /app/secretpixel)
# SECRETPXEL_BIN=/app/secretpixel

# --- Frontend Configuration (Vercel Environment Variables) ---
# Set VITE_API_BASE_URL to your Render web service URL
# Example: VITE_API_BASE_URL=https://secretpixel-api.onrender.com
VITE_API_BASE_URL=https://your-backend-service.onrender.com
